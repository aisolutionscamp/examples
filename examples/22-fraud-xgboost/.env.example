# Scoring service
FRAUD_MODEL_PATH=model/fraud_model.json
# Score >= REVIEW threshold -> step-up verification, >= BLOCK threshold -> decline.
# Leave REVIEW empty to use the threshold chosen during training (stored next to the model).
FRAUD_REVIEW_THRESHOLD=
FRAUD_BLOCK_THRESHOLD=0.9

# Optional adapters
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=transactions
KAFKA_OUTPUT_TOPIC=fraud-decisions
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=fraud-decisions
