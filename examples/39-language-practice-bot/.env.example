OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-6-luna
# Local alternative with Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
# Speech input (requirements-speech.txt)
WHISPER_MODEL=small
# Speech output: piper (local, needs a voice file) or openai (Speech API, deprecated, shuts down 2027-01-06)
TTS_BACKEND=piper
PIPER_VOICE=voices/es_ES-davefx-medium.onnx
