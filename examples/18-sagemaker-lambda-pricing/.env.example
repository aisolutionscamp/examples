AWS_REGION=eu-central-1
# IAM role SageMaker assumes for the AutoML job and the endpoint
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/ExampleSageMakerRole
TRAINING_BUCKET=example-retail-forecasting
# Lambda environment
SAGEMAKER_ENDPOINT_NAME=demand-forecast
METRICS_NAMESPACE=Example/DynamicPricing
