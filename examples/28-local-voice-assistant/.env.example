# Local LLM through Ollama's OpenAI-compatible API (no cloud call, the key is ignored by Ollama)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Speech-to-text (faster-whisper model size or a local path) and text-to-speech (Piper voice file)
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
PIPER_VOICE=voices/en_US-lessac-medium.onnx

# Reminders are stored in this JSON file
REMINDERS_FILE=reminders.json

# Emergency escalation: a webhook that forwards a message to a family member or carer
# (e.g. a self-hosted ntfy topic or a home-automation webhook). Leave empty to disable.
EMERGENCY_WEBHOOK_URL=
EMERGENCY_CONTACT_NAME=your daughter
LOCAL_EMERGENCY_NUMBER=112
